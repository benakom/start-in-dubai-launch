---
// Hero sombre et lumineux : image en fondu, halo rouge, bande aux couleurs des Émirats, bouton qui pulse.
import type { Lang } from "../../content.config";
import { UI } from "../../data/ui";
import { LANDING } from "../../lib/site";
import Arrow from "../Arrow.astro";
interface Crumb { href?: string; label: string }
interface Props { lang: Lang; title: string; intro?: string; pill?: string; image: string; crumbs?: Crumb[]; meta?: boolean; updated?: Date; minutes?: number; authorHref?: string; profile?: string; cta?: string; children?: any }
const { lang, title, intro, pill, image, crumbs = [], meta = false, updated, minutes, authorHref = "#auteur", profile, cta } = Astro.props;
const u = UI[lang], t = LANDING[lang];
const iso = updated?.toISOString().slice(0, 10);
const human = updated?.toLocaleDateString({ fr: "fr-FR", ar: "ar-AE", en: "en-GB", es: "es-ES", nl: "nl-NL", it: "it-IT" }[lang], { day: "numeric", month: "long", year: "numeric", numberingSystem: "latn" });
---
<header class="xhero hero">
  <div class="xhero-bg"><img src={image} alt="" width="900" height="600" fetchpriority="high" decoding="async" /></div>
  <div class="wrap">
    <div class="xhero-in">
      {crumbs.length > 0 && (
        <ol class="crumbs">{crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</li>)}</ol>
      )}
      {pill && <p class="pill">{pill}</p>}
      <h1>{title}</h1>
      {meta && (
        <p class="xhero-meta">
          <span class="badge"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>{u.heroBadge}</span>
          {iso && <span>{u.updated} <time datetime={iso}>{human}</time></span>}
          <span>{u.by} <a href={authorHref}>{u.team}</a></span>
          {minutes && <span>{minutes} {u.read}</span>}
        </p>
      )}
      {intro && <p class="xhero-intro">{intro}</p>}
      <div class="cta">
        <button class="btn btn-pulse" type="button" data-open-form data-profile={profile}><span class="btn-txt">{cta || u.heroCta}</span><Arrow /></button>
        <p class="cta-note">{u.heroNote}</p>
      </div>
      <ul class="trust"><li set:html={t.t019} /><li set:html={t.t020} /><li set:html={t.t021} /></ul>
    </div>
  </div>
</header>
