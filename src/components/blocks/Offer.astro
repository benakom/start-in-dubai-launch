---
import type { Lang } from "../../content.config";
import { LANDING } from "../../lib/site";
import Arrow from "../Arrow.astro";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = LANDING[lang];
---
<section class="sec" aria-labelledby="of-t">
  <div class="wrap narrow">
    <div class="offer rv">
      <p class="offer-tag">{t.t092}</p>
      <h2 id="of-t">{t.t093}</h2>
      <ul class="vlist"><li set:html={t.t094} /><li set:html={t.t095} /><li set:html={t.t096} /></ul>
      <p class="offer-free" set:html={t.t097} />
      <div class="cta center"><button class="btn" type="button" data-open-form><span class="btn-txt">{t.t017}</span><Arrow /></button></div>
    </div>
  </div>
</section>
