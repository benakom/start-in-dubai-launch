---
import type { Lang } from "../../content.config";
import { UI } from "../../data/ui";
interface Props { lang: Lang; items: { slug: string; text: string }[] }
const { lang, items } = Astro.props;
---
{items.length > 2 && (
  <nav class="toc" aria-label={UI[lang].toc}><p>{UI[lang].toc}</p><ol>{items.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>
)}
