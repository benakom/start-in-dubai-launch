---
import type { Lang } from "../../content.config";
import { UI } from "../../data/ui";
import { LANDING } from "../../lib/site";
interface Props { lang: Lang }
const { lang } = Astro.props;
const u = UI[lang], t = LANDING[lang];
---
<div class="side-cta">
  <p class="t">{u.midTitle}</p>
  <p>{u.hubText}</p>
  <button class="btn" type="button" data-open-form><span class="btn-txt">{t.t007}</span></button>
</div>
