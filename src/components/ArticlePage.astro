---
import { srcset } from "../lib/img";
// Page guide ou article de blog (6 langues), assemblée à partir des blocs de src/components/blocks.
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "./blocks/Hero.astro";
import Stats from "./blocks/Stats.astro";
import Essentials from "./blocks/Essentials.astro";
import Toc from "./blocks/Toc.astro";
import MidCta from "./blocks/MidCta.astro";
import SideCta from "./blocks/SideCta.astro";
import Profiles from "./blocks/Profiles.astro";
import Offer from "./blocks/Offer.astro";
import Faq from "./blocks/Faq.astro";
import Cards from "./blocks/Cards.astro";
import FinalCta from "./blocks/FinalCta.astro";
import { UI, CLUSTER_IMG } from "../data/ui";
import { AUTHOR } from "../data/site";
import { allGuides, entries, langOf, keyOf, entryPath, homePath, guidesPath, hubPath, translations, entryTranslations, alternates, abs, readingMinutes, SITE_URL } from "../lib/site";

interface Props { entry: any; coll: "guides" | "blog" }
const { entry, coll } = Astro.props;
const d = entry.data;
const lang = langOf(entry);
const u = UI[lang];
const { Content, headings } = await render(entry);
const path = entryPath(coll, entry);
const url = abs(path);
const key = keyOf(entry);
const hub = coll === "blog" ? hubPath("blog", lang) : guidesPath(lang);
const hubLabel = coll === "blog" ? u.blog : u.guides;
const alts = alternates(coll === "blog" ? await entryTranslations("blog", key) : await translations(key), (l) => (coll === "blog" ? hubPath("blog", l) : guidesPath(l)));
const guides = (await allGuides()).filter((g) => langOf(g) === lang && g.id !== entry.id);
const byKey = new Map(guides.map((g) => [keyOf(g), g]));
const related = d.related.map((k: string) => byKey.get(k)).filter(Boolean);
const more = guides.filter((g) => g.data.cluster === d.cluster && !related.includes(g));
const cards = [...related, ...more].slice(0, 6);
const services = (await entries("services")).filter((s: any) => langOf(s) === lang);
const service = services.find((s: any) => s.data.cluster === d.cluster) || services[0];
const langPosts = (await entries("blog")).filter((b: any) => langOf(b) === lang && b.id !== entry.id);
// Maillage du blog : d'abord les articles du même thème, puis les plus récents ; aussi sous les guides.
const posts = [...langPosts.filter((b: any) => b.data.cluster === d.cluster), ...langPosts.filter((b: any) => b.data.cluster !== d.cluster)].slice(0, coll === "blog" ? 6 : 3);
const image = d.image || CLUSTER_IMG[d.cluster];
const updated = d.updated.toISOString().slice(0, 10);
const toc = headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text }));
const minutes = readingMinutes(entry.body || "");

const jsonld = [
  {
    "@context": "https://schema.org", "@type": coll === "blog" ? "BlogPosting" : "Article", headline: d.h1, description: d.description, inLanguage: lang,
    datePublished: updated, dateModified: updated, mainEntityOfPage: url, image: d.imageAlt ? { "@type": "ImageObject", url: SITE_URL + image, caption: d.imageAlt, ...(d.imageCredit ? { creditText: d.imageCredit } : {}) } : SITE_URL + image,
    keywords: [d.keyword, ...d.secondary].join(", "), about: d.keyword,
    ...(d.essentials.length ? { abstract: d.essentials.join(" ") } : {}),
    author: { "@type": "Organization", "@id": `${SITE_URL}/#organization`, name: AUTHOR.name, url: AUTHOR.url },
    publisher: { "@type": "Organization", "@id": `${SITE_URL}/#organization`, name: "Start in Dubai", url: SITE_URL + "/", logo: { "@type": "ImageObject", url: `${SITE_URL}/assets/img/logo.webp` } },
    citation: d.sources.map((s: any) => s.url),
  },
  {
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: u.home, item: abs(homePath(lang)) },
      { "@type": "ListItem", position: 2, name: hubLabel, item: abs(hub) },
      { "@type": "ListItem", position: 3, name: d.h1, item: url },
    ],
  },
  ...(d.faq.length ? [{
    "@context": "https://schema.org", "@type": "FAQPage", inLanguage: lang,
    mainEntity: d.faq.map((f: any) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  }] : []),
];
---
<Base lang={lang} title={d.title} description={d.description} path={path} alternates={alts} jsonld={jsonld} image={image} nav={coll === "blog" ? "blog" : d.cluster}>
  <Hero lang={lang} title={d.h1} intro={d.intro} pill={u.clusters[d.cluster]} image={image} meta updated={d.updated} minutes={minutes}
    crumbs={[{ href: homePath(lang), label: u.home }, { href: hub, label: hubLabel }, ...(coll === "guides" ? [{ href: `${guidesPath(lang)}#${d.cluster}`, label: u.clusters[d.cluster] }] : [])]} />
  <Stats lang={lang} />

  <div class="wrap">
    <div class="art">
      <article class="art-main">
        {d.image && d.imageAlt && (
          <figure class="cover">
            <img src={d.image} srcset={srcset(d.image)} sizes="(max-width: 900px) 100vw, 760px" alt={d.imageAlt} width="1200" height="800" decoding="async" />
            {d.imageCredit && <figcaption>{d.imageCredit}</figcaption>}
          </figure>
        )}
        <Essentials lang={lang} items={d.essentials} />
        <Toc lang={lang} items={toc} />
        <div class="prose"><Content /></div>
        <MidCta lang={lang} />

        {service && (
          <a class="svc-link rv" href={entryPath("services", service)}>
            <span class="eyebrow">{u.ourServices}</span>
            <span class="svc-t">{service.data.h1}</span>
            <span class="svc-d">{service.data.intro}</span>
            <span class="card-go">{u.seeService} →</span>
          </a>
        )}

        {d.sources.length > 0 && (
          <section class="srcs" aria-labelledby="sources">
            <h2 id="sources">{u.sources}</h2>
            <ul>{d.sources.map((s: any) => <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.label}</a></li>)}</ul>
          </section>
        )}

        <section class="author" id="auteur" aria-label={u.author}>
          <img src="/assets/img/logo-256.webp" alt="Start in Dubai" width="96" height="62" loading="lazy" />
          <div>
            <p class="n">{u.author}</p>
            <p>{u.teamBio}</p>
          </div>
        </section>
      </article>
      <aside class="art-side"><div class="side-box"><SideCta lang={lang} /></div></aside>
    </div>
  </div>

  <Profiles lang={lang} />
  <Offer lang={lang} />
  <Faq lang={lang} items={d.faq} />

  {cards.length > 0 && (
    <section class="sec sec-gray" aria-labelledby="lire">
      <div class="wrap">
        <p class="eyebrow center">{u.relatedEyebrow}</p>
        <h2 id="lire" class="center">{u.related}</h2>
        <Cards lang={lang} items={cards} />
        {posts.length > 0 && <Cards lang={lang} items={posts} coll="blog" />}
      </div>
    </section>
  )}

  <FinalCta lang={lang} />
</Base>
