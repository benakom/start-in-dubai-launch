---
import { srcset } from "../lib/img";
// Page service : ce que START IN DUBAI fait pour vous, le déroulé, la FAQ commerciale, les guides liés.
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "./blocks/Hero.astro";
import Stats from "./blocks/Stats.astro";
import MidCta from "./blocks/MidCta.astro";
import SideCta from "./blocks/SideCta.astro";
import Offer from "./blocks/Offer.astro";
import Founder from "./blocks/Founder.astro";
import Faq from "./blocks/Faq.astro";
import Cards from "./blocks/Cards.astro";
import FinalCta from "./blocks/FinalCta.astro";
import Arrow from "./Arrow.astro";
import { UI, CLUSTER_IMG } from "../data/ui";
import { allGuides, entries, langOf, keyOf, entryPath, homePath, hubPath, entryTranslations, alternates, abs, SITE_URL } from "../lib/site";

interface Props { entry: any }
const { entry } = Astro.props;
const d = entry.data;
const lang = langOf(entry);
const u = UI[lang];
const { Content } = await render(entry);
const path = entryPath("services", entry);
const url = abs(path);
const alts = alternates(await entryTranslations("services", keyOf(entry)), (l) => hubPath("services", l));
const guides = (await allGuides()).filter((g) => langOf(g) === lang);
const byKey = new Map(guides.map((g) => [keyOf(g), g]));
const related = d.related.map((k: string) => byKey.get(k)).filter(Boolean);
const cards = [...related, ...guides.filter((g) => g.data.cluster === d.cluster && !related.includes(g))].slice(0, 6);
const others = (await entries("services")).filter((s: any) => langOf(s) === lang && s.id !== entry.id);
const image = d.image || CLUSTER_IMG[d.cluster];

const jsonld = [
  {
    "@context": "https://schema.org", "@type": "Service", name: d.h1, description: d.description, serviceType: d.keyword, url, inLanguage: lang, image: SITE_URL + image,
    provider: { "@type": "Organization", "@id": `${SITE_URL}/#organization`, name: "START IN DUBAI", url: SITE_URL + "/" },
    areaServed: [{ "@type": "City", name: "Dubai" }, { "@type": "Country", name: "United Arab Emirates" }],
    availableLanguage: ["ar", "fr", "en", "es", "nl", "it"],
    hasOfferCatalog: { "@type": "OfferCatalog", name: u.included, itemListElement: d.essentials.map((e: string) => ({ "@type": "Offer", itemOffered: { "@type": "Service", name: e } })) },
  },
  {
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: u.home, item: abs(homePath(lang)) },
      { "@type": "ListItem", position: 2, name: u.services, item: abs(hubPath("services", lang)) },
      { "@type": "ListItem", position: 3, name: d.h1, item: url },
    ],
  },
  ...(d.faq.length ? [{ "@context": "https://schema.org", "@type": "FAQPage", inLanguage: lang, mainEntity: d.faq.map((f: any) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) }] : []),
];
---
<Base lang={lang} title={d.title} description={d.description} path={path} alternates={alts} jsonld={jsonld} image={image} nav="services">
  <Hero lang={lang} title={d.h1} intro={d.intro} pill={u.services} image={image} profile={d.profile}
    crumbs={[{ href: homePath(lang), label: u.home }, { href: hubPath("services", lang), label: u.services }]} />
  <Stats lang={lang} />

  <section class="sec" aria-labelledby="inc-t">
    <div class="wrap">
      {d.image && d.imageAlt && (
        <figure class="cover svc-cover">
          <img src={d.image} srcset={srcset(d.image)} sizes="(max-width: 960px) 100vw, 960px" alt={d.imageAlt} width="1200" height="800" loading="lazy" decoding="async" />
          {d.imageCredit && <figcaption>{d.imageCredit}</figcaption>}
        </figure>
      )}
      <p class="eyebrow center">{u.servicesEyebrow}</p>
      <h2 id="inc-t" class="center">{u.included}</h2>
      <ul class="incl">{d.essentials.map((e: string) => <li class="rv">{e}</li>)}</ul>
      <div class="cta center"><button class="btn" type="button" data-open-form data-profile={d.profile}><span class="btn-txt">{u.heroCta}</span><Arrow /></button><p class="cta-note">{u.heroNote}</p></div>
    </div>
  </section>

  {d.steps.length > 0 && (
    <section class="sec sec-gray" aria-labelledby="how-t">
      <div class="wrap">
        <p class="eyebrow center">{u.howEyebrow}</p>
        <h2 id="how-t" class="center">{u.how}</h2>
        <ol class="steps">{d.steps.map((s: any) => <li class="rv"><b>{s.t}</b><span>{s.d}</span></li>)}</ol>
      </div>
    </section>
  )}

  <div class="wrap">
    <div class="art">
      <article class="art-main">
        <div class="prose"><Content /></div>
        <MidCta lang={lang} />
        {d.sources.length > 0 && (
          <section class="srcs" aria-labelledby="sources">
            <h2 id="sources">{u.sources}</h2>
            <ul>{d.sources.map((s: any) => <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.label}</a></li>)}</ul>
          </section>
        )}
      </article>
      <aside class="art-side"><div class="side-box"><SideCta lang={lang} /></div></aside>
    </div>
  </div>

  <Offer lang={lang} />
  <Faq lang={lang} items={d.faq} />
  <Founder lang={lang} />

  {cards.length > 0 && (
    <section class="sec" aria-labelledby="g-t">
      <div class="wrap">
        <p class="eyebrow center">{u.relatedEyebrow}</p>
        <h2 id="g-t" class="center">{u.serviceGuides}</h2>
        <Cards lang={lang} items={cards} />
      </div>
    </section>
  )}
  {others.length > 0 && (
    <section class="sec sec-gray" aria-labelledby="o-t">
      <div class="wrap">
        <h2 id="o-t" class="center">{u.ourServices}</h2>
        <Cards lang={lang} items={others} coll="services" />
      </div>
    </section>
  )}
  <FinalCta lang={lang} />
</Base>
