---
import { readFileSync } from "node:fs";
// CSS en ligne (évite 2 requêtes bloquantes au premier affichage)
const INLINE_CSS = ["style.css", "site.css"].map((f) => readFileSync(`public/assets/${f}`, "utf-8")).join("\n");
// Mise en page commune des pages du site : même barre du haut, même formulaire et même pied de page que la page de lancement.
import type { Lang } from "../content.config";
import { LANGS } from "../content.config";
import { UI, OG_LOCALE, LANG_NAMES } from "../data/ui";
import { LANDING, FORM, PREVIEW, SITE_URL, abs, homePath, guidesPath, hubPath, entries, langOf } from "../lib/site";

interface Alt { lang: Lang; href: string; exists: boolean }
interface Props { lang: Lang; title: string; description: string; path: string; alternates: Alt[]; jsonld?: object[]; ogType?: string; image?: string; nav?: string }
const { lang, title, description, path, alternates, jsonld = [], ogType = "article", image = "/assets/img/og.jpg", nav = "" } = Astro.props;
const u = UI[lang], t = LANDING[lang];
const rtl = lang === "ar";
const url = abs(path);
const fullTitle = `${title} | Start in Dubai`;
const xdef = alternates.find((a) => a.lang === "fr" && a.exists)?.href || path;
const has = async (c: "services" | "blog") => new Set((await entries(c)).map((e: any) => langOf(e))).has(lang);
const navItems = [
  ...((await has("services")) ? [{ href: hubPath("services", lang), label: u.services, key: "services" }] : []),
  { href: guidesPath(lang), label: u.guides, key: "guides" },
  ...((await has("blog")) ? [{ href: hubPath("blog", lang), label: u.blog, key: "blog" }] : []),
  { href: guidesPath(lang) + "#societe", label: u.clusters.societe, key: "societe" },
  { href: guidesPath(lang) + "#visas", label: u.clusters.visas, key: "visas" },
  { href: guidesPath(lang) + "#etudes", label: u.clusters.etudes, key: "etudes" },
];
const fonts = "https://fonts.googleapis.com/css2?" + (rtl ? "family=Noto+Kufi+Arabic:wght@500;700;800&" : "") + "family=Montserrat:wght@700;800;900&family=Inter:wght@400;500;600;700&display=optional";
---
<!doctype html>
<html lang={lang} dir={rtl ? "rtl" : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {PREVIEW && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={url} />
  {alternates.filter((a) => a.exists).map((a) => <link rel="alternate" hreflang={a.lang} href={abs(a.href)} />)}
  <link rel="alternate" hreflang="x-default" href={abs(xdef)} />
  <meta name="theme-color" content="#0B0B0B" />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Start in Dubai" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={SITE_URL + image} />
  <meta property="og:locale" content={OG_LOCALE[lang]} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/img/favicon-96.png?v=2" />
  <link rel="icon" type="image/png" sizes="48x48" href="/assets/img/favicon-48.png?v=2" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png?v=2" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href={fonts} />
  <link href={fonts} rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href={fonts} rel="stylesheet" /></noscript>
  <style is:inline set:html={INLINE_CSS}></style>
  {jsonld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
</head>
<body>
  <div class="hdr">
    {PREVIEW && <p class="preview-note">{u.previewNote}</p>}
    <div class="topbar">
      <div class="wrap topbar-in">
        <p class="topbar-txt" set:html={t.t006} />
        <label class="lang-sw"><span class="sr">{u.language}</span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
          <select data-lang-nav aria-label="Langue / Language">
            {alternates.map((a) => <option value={a.href} data-l={a.lang} selected={a.lang === lang}>{LANG_NAMES[a.lang]}</option>)}
          </select>
        </label>
        <button class="topbar-btn" type="button" data-open-form><span class="btn-txt">{t.t007}</span></button>
      </div>
    </div>
    <nav class="nav" aria-label={u.menu} data-nav>
      <div class="wrap nav-in">
        <a class="nav-logo" href={homePath(lang)} aria-label={`Start in Dubai, ${u.home}`}><img src="/assets/img/logo-256.webp" alt="Start in Dubai" width="256" height="165" /></a>
        <ul class="nav-links" id="nav-links">
          {navItems.map((n) => <li><a href={n.href} aria-current={n.key === nav ? "page" : undefined}>{n.label}</a></li>)}
        </ul>
        <button class="btn btn-sm nav-cta" type="button" data-open-form><span class="btn-txt">{u.signup}</span></button>
        <button class="nav-burger" type="button" aria-expanded="false" aria-controls="nav-links" data-burger><span></span><b class="sr">{u.menu}</b></button>
      </div>
    </nav>
  </div>

  <main><slot /></main>

  <footer class="foot">
    <section class="fct" aria-labelledby="fct-t">
      <div class="wrap fct-in">
        <h2 class="fct-t" id="fct-t">{t.c14}</h2>
        <div class="fct-cards">
          <a class="fct-card" href="mailto:hello@startindubai.com"><span class="fct-ic"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M3 6h18v12H3z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M3 7l9 6 9-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span><span class="fct-tx"><small>{t.c15}</small><b>hello@startindubai.com</b></span></a>
          <a class="fct-card" href="https://www.google.com/maps/search/?api=1&amp;query=Goldcrest%20Executive%20Jumeirah%20Lakes%20Towers%20Dubai" target="_blank" rel="noopener"><span class="fct-ic"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="12" cy="9.5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></span><span class="fct-tx"><small>{t.c16}</small><b>1104 Goldcrest Executive</b><span dir="ltr">Al Thanyah Fifth, Jumeirah Lakes Towers (JLT)</span><span>{t.c18}</span><em>{t.c17}</em></span></a>
        </div>
      </div>
    </section>
    <div class="wrap foot-in">
      <img src="/assets/img/logo-384.webp" alt="Start in Dubai" width="384" height="247" loading="lazy" />
      <p>{navItems.filter((n) => n.key === "services" || n.key === "blog").map((n) => <><a href={n.href}>{n.label}</a> · </>)}<a href={guidesPath(lang)}>{u.allGuides}</a>{Object.entries(u.clusters).map(([k, v]) => <> · <a href={`${guidesPath(lang)}#${k}`}>{v}</a></>)}</p>
      <p set:html={t.t123} />
      <p class="langs">{LANGS.map((l, i) => <>{i > 0 && " · "}<a href={alternates.find((a) => a.lang === l)?.href || homePath(l)} hreflang={l} lang={l} data-lang-link={l} aria-current={l === lang ? "page" : undefined}>{LANG_NAMES[l]}</a></>)}</p>
      <p class="small">{u.disclaimer}</p>
    </div>
  </footer>

  <div class="sticky" data-sticky>
    <button class="btn" type="button" data-open-form><span class="btn-txt">{t.t122}</span></button>
  </div>

  <div class="tf" id="tf" role="dialog" aria-modal="true" aria-label={t.t125} hidden>
    <div class="tf-progress"><span></span></div>
    <header class="tf-head">
      <img src="/assets/img/logo-256.webp" alt="Start in Dubai" width="256" height="165" loading="lazy" />
      <button type="button" class="tf-close" data-close-form aria-label={t.t126}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></button>
    </header>
    <form class="tf-stage" novalidate autocomplete="on"></form>
    <nav class="tf-nav" aria-label={t.t127}>
      <button type="button" data-prev aria-label={t.t128}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 15l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
      <button type="button" data-next aria-label={t.t129}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
    </nav>
  </div>

  <dialog class="privacy" id="privacy">
    <h2>{t.t130}</h2>
    <p>{t.t131}</p>
    <p>{t.t132}</p>
    <p>{t.c13}</p>
    <form method="dialog"><button class="btn btn-sm">{t.t126}</button></form>
  </dialog>

  <script is:inline set:html={`window.SID_I18N=${JSON.stringify(FORM[lang])};`} />
  <script src="/config.js" is:inline></script>
  <script src="/assets/app.js?v=3" is:inline></script>
  <script src="/assets/site.js?v=3" is:inline></script>
</body>
</html>
