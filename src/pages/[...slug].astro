---
// Toutes les pages de contenu : guides (/<slug>/), blog (/blog/<slug>/), services (/services/<slug>/), en 6 langues.
import ArticlePage from "../components/ArticlePage.astro";
import ServicePage from "../components/ServicePage.astro";
import { allGuides, entries, entryPath } from "../lib/site";

export async function getStaticPaths() {
  const out: any[] = [];
  const add = (coll: string, e: any) => out.push({ params: { slug: entryPath(coll as any, e).slice(1, -1) }, props: { entry: e, coll } });
  for (const g of await allGuides()) add("guides", g);
  for (const b of await entries("blog")) add("blog", b);
  for (const s of await entries("services")) add("services", s);
  return out;
}
const { entry, coll } = Astro.props;
---
{coll === "services" ? <ServicePage entry={entry} /> : <ArticlePage entry={entry} coll={coll} />}
