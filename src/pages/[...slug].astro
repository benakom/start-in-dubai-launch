---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import { CLUSTERS } from "../content.config";
import { SITE, AUTHOR, PARTNER } from "../data/site";

export async function getStaticPaths() {
  const all = await getCollection("guides", (g) => !g.data.draft);
  return all.map((g) => ({ params: { slug: g.id }, props: { guide: g, all } }));
}
const { guide, all } = Astro.props;
const d = guide.data;
const { Content, headings } = await render(guide);
const path = `/${guide.id}/`;
const url = SITE.url + path;
const updated = d.updated.toISOString().slice(0, 10);
const updatedFr = d.updated.toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" });
const toc = headings.filter((h) => h.depth === 2);
const bySlug = new Map(all.map((g) => [g.id, g]));
const related = d.related.map((s) => bySlug.get(s)).filter(Boolean);
const sameCluster = all.filter((g) => g.data.cluster === d.cluster && g.id !== guide.id && !d.related.includes(g.id)).sort((a, b) => a.data.order - b.data.order).slice(0, 4);

const jsonld = [
  {
    "@context": "https://schema.org", "@type": "Article", headline: d.h1, description: d.description,
    inLanguage: "fr", datePublished: updated, dateModified: updated, mainEntityOfPage: url,
    image: `${SITE.url}/assets/img/og.jpg`,
    author: { "@type": "Person", name: AUTHOR.name, url: AUTHOR.url, jobTitle: AUTHOR.role, sameAs: AUTHOR.sameAs },
    publisher: { "@type": "Organization", name: SITE.name, url: SITE.url, logo: { "@type": "ImageObject", url: SITE.logo } },
    about: d.keyword,
  },
  {
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: SITE.url + "/" },
      { "@type": "ListItem", position: 2, name: "Guides", item: SITE.url + "/guides/" },
      { "@type": "ListItem", position: 3, name: d.h1, item: url },
    ],
  },
  ...(d.faq.length ? [{
    "@context": "https://schema.org", "@type": "FAQPage",
    mainEntity: d.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  }] : []),
];
---
<Base title={d.title} description={d.description} path={path} jsonld={jsonld}>
  <article class="g-wrap g-article">
    <nav class="g-crumbs" aria-label="Fil d'Ariane"><a href="/">Accueil</a> › <a href="/guides/">Guides</a> › <span>{CLUSTERS[d.cluster]}</span></nav>
    <h1>{d.h1}</h1>
    <p class="g-meta">Mis à jour le <time datetime={updated}>{updatedFr}</time> · par <a href="#auteur">{AUTHOR.name}</a></p>
    <p class="g-intro">{d.intro}</p>

    {toc.length > 2 && (
      <nav class="g-toc" aria-label="Sommaire">
        <p>Sommaire</p>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    )}

    <div class="g-prose"><Content /></div>

    <aside class="g-cta">
      <p class="g-cta-t">Votre projet à Dubaï, de A à Z, avec un seul interlocuteur</p>
      <p>Société, compte bancaire, visas, logement, écoles : START IN DUBAI coordonne tout, en français et en darija. Inscrivez-vous en avant-première et soyez rappelé en priorité.</p>
      <a class="g-btn" href={SITE.signup}>Je m'inscris gratuitement →</a>
    </aside>

    {d.faq.length > 0 && (
      <section class="g-faq" aria-labelledby="faq">
        <h2 id="faq">Questions fréquentes</h2>
        {d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </section>
    )}

    {d.sources.length > 0 && (
      <section class="g-sources" aria-labelledby="sources">
        <h2 id="sources">Sources officielles</h2>
        <ul>{d.sources.map((s) => <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.label}</a></li>)}</ul>
      </section>
    )}

    <section class="g-author" id="auteur" aria-label="Auteur">
      <img src="/assets/img/ahmed-benjas.jpg" alt={AUTHOR.name} width="96" height="120" loading="lazy" />
      <div>
        <p class="g-author-n"><a href={AUTHOR.url}>{AUTHOR.name}</a></p>
        <p class="g-author-r">{AUTHOR.role}</p>
        <p>{AUTHOR.bio}</p>
      </div>
    </section>

    {(related.length > 0 || sameCluster.length > 0) && (
      <section class="g-related" aria-labelledby="lire">
        <h2 id="lire">À lire aussi</h2>
        <ul>{[...related, ...sameCluster].slice(0, 6).map((g) => <li><a href={`/${g!.id}/`}>{g!.data.h1}</a></li>)}</ul>
      </section>
    )}
  </article>
</Base>
