{
  "name": "start-in-dubai-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "python3 tools/i18n.py build && astro build",
    "preview": "astro preview --port 4321",
    "check": "node scripts/check-content.mjs",
    "build:preview": "python3 tools/i18n.py build && SID_PREVIEW=1 astro build && node scripts/preview.mjs"
  },
  "dependencies": {
    "astro": "5.18.2"
  }
}
